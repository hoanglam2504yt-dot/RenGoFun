# ==========================================
# RenGoFun - Git Ignore Configuration
# ==========================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
!.env.local.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.pfx

# --- Node & Frontend Dependencies / Builds ---
node_modules/
dist/
dist-ssr/

# --- Rust & Tauri ---
src-tauri/target/
src-tauri/gen/schemas/

# --- Python Engine & Virtual Environments ---
venv/
.venv/
python_engine/venv/
python_engine/__pycache__/
__pycache__/
*.py[cod]
*$py.class

# --- Executables, Installers & Dev Scripts ---
*.exe
*.msi
rustup-init.exe
# Script khởi động nội bộ (chứa path tuyệt đối, không nên commit)
start_dev.bat
start_silent.vbs

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor & IDE Files ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- Docs / Temp Notes ---
md/

# --- Python Engine Outputs ---
python_engine/output/
python_engine/temp/
python_engine/*.db
python_engine/*.sqlite